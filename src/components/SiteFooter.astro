---
import { SITE } from '../lib/site';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-main">
      <div class="footer-brand">
        <span class="brand-mark" aria-hidden="true"><span>YH</span></span>
        <div>
          <strong>YHHD Notes</strong>
          <p>记录软件、智能体与那些值得反复思考的问题。</p>
        </div>
      </div>
      <nav class="footer-links" aria-label="页脚导航">
        <a href="/posts/">文章</a>
        <a href="/wiki/">知识库</a>
        <a href="/archives/">归档</a>
        <a href="/about/">关于</a>
        <a href="/rss.xml">RSS</a>
        <a href={SITE.github} target="_blank" rel="noreferrer">GitHub</a>
      </nav>
    </div>
    <div class="footer-bottom">
      <span>© {SITE.since}–{SITE.copyrightYear} Haohao Yin</span>
      <span>Built with Astro · Hosted on GitHub Pages</span>
    </div>
  </div>
</footer>
