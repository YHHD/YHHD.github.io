---
import Icon from './Icon.astro';
import { SITE, tagSlug } from '../lib/site';

interface Props {
  tags: Array<[string, number]>;
}

const { tags } = Astro.props;
const visible = tags.slice(0, 22);
---

<aside class="posts-sidebar">
  <div class="sidebar-card">
    <div class="sidebar-card__heading">
      <span>标签</span>
      <span>{String(tags.length).padStart(2, '0')}</span>
    </div>
    <div class="tag-cloud">
      {visible.map(([tag, count]) => (
        <a class="tag" href={`/tags/${tagSlug(tag)}/`} aria-label={`${tag}，${count} 篇`}>
          {tag}<sup>{count}</sup>
        </a>
      ))}
    </div>
    <a class="text-link" href="/tags/">全部标签 <Icon name="arrow-right" /></a>
  </div>

  <div class="sidebar-note">
    <span class="eyebrow">Subscribe</span>
    <h3>用 RSS 阅读</h3>
    <p>不注册、不追踪、不依赖算法。新文章通过 RSS 直接送达你的阅读器。</p>
    <a class="button" href="/rss.xml"><Icon name="rss" /> 订阅 RSS</a>
  </div>

  <div class="sidebar-project">
    <span class="sidebar-project__dot"></span>
    <div>
      <strong>正在维护 · TPS Bench</strong>
      <p>本地 LLM API 测速台。测量 TTFT、解码 TPS 与端到端吞吐。</p>
      <a href="https://github.com/YHHD/tps-bench" target="_blank" rel="noreferrer">查看项目 <Icon name="arrow-up-right" /></a>
    </div>
  </div>

  <a class="sidebar-github" href={SITE.github} target="_blank" rel="noreferrer">
    <Icon name="github" />
    <span>在 GitHub 上找到我</span>
    <Icon name="arrow-up-right" />
  </a>
</aside>
