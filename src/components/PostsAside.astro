---
import Icon from './Icon.astro';
import { tagSlug } from '../lib/site';

interface Props {
  tags: Array<[string, number]>;
}

const { tags } = Astro.props;
---

<aside class="ref-sidebar">
  <div class="ref-sidebar__heading">
    <span>标签</span>
    <span>{String(tags.length).padStart(2, '0')}</span>
  </div>
  <div class="ref-tag-cloud">
    {tags.map(([tag, count]) => (
      <a class="ref-tag" href={`/tags/${tagSlug(tag)}/`} aria-label={`${tag}，${count} 篇`}>
        {tag}<sup>{count}</sup>
      </a>
    ))}
  </div>
  <a class="ref-sidebar__all" href="/tags/">全部标签 <Icon name="arrow-right" /></a>
</aside>
