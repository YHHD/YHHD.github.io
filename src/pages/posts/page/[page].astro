---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Pagination from '../../../components/Pagination.astro';
import PostCard from '../../../components/PostCard.astro';
import PostsAside from '../../../components/PostsAside.astro';
import { getPosts, tagCounts } from '../../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  const pageSize = 10;
  const lastPage = Math.ceil(posts.length / pageSize);
  return Array.from({ length: Math.max(0, lastPage - 1) }, (_, index) => {
    const currentPage = index + 2;
    return {
      params: { page: String(currentPage) },
      props: {
        posts: posts.slice((currentPage - 1) * pageSize, currentPage * pageSize),
        currentPage,
        lastPage,
        total: posts.length,
      },
    };
  });
}

const { posts, currentPage, lastPage, total } = Astro.props;
const tags = tagCounts(await getPosts());
---

<BaseLayout title={`博客 · 第 ${currentPage} 页`} description={`浏览第 ${currentPage} 页工程札记。`} noindex>
  <h1 class="sr-only">博客</h1>
  <div class="container posts-reference-layout">
    <main>
      <div class="ref-list-heading">
        <span>博客</span>
        <span>{total} 篇</span>
      </div>
      <div class="ref-post-list">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
      <Pagination currentPage={currentPage} lastPage={lastPage} basePath="/posts" />
    </main>
    <PostsAside tags={tags} />
  </div>
</BaseLayout>
