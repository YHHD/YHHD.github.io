---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Pagination from '../../../components/Pagination.astro';
import PostCard from '../../../components/PostCard.astro';
import PostsAside from '../../../components/PostsAside.astro';
import { getPosts, tagCounts } from '../../../lib/content';
import { tagSlug } from '../../../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  const pageSize = 10;
  const lastPage = Math.ceil(posts.length / pageSize);
  return Array.from({ length: Math.max(0, lastPage - 1) }, (_, index) => {
    const currentPage = index + 2;
    return {
      params: { page: String(currentPage) },
      props: {
        posts: posts.slice((currentPage - 1) * pageSize, currentPage * pageSize),
        currentPage,
        lastPage,
        total: posts.length,
      },
    };
  });
}

const { posts, currentPage, lastPage, total } = Astro.props;
const allPosts = await getPosts();
const tags = tagCounts(allPosts);
---

<BaseLayout title={`文章 · 第 ${currentPage} 页`} description={`浏览第 ${currentPage} 页工程札记。`} noindex>
  <section class="page-hero">
    <div class="container">
      <div class="page-hero__inner">
        <div>
          <span class="eyebrow">Writing / Page {currentPage}</span>
          <h1>文章与工程札记</h1>
          <p>共 {total} 篇文章。当前是第 {currentPage} 页。</p>
        </div>
        <aside class="page-hero__aside">
          <strong>按时间倒序排列</strong>
          点击标签进入相关主题，或者使用右上角搜索快速找到一篇旧文。
        </aside>
      </div>
    </div>
  </section>

  <div class="container">
    <div class="filter-bar">
      <span class="filter-label">Topics</span>
      <a class="filter-chip" href="/posts/">全部</a>
      {tags.slice(0, 8).map(([tag]) => (
        <a class="filter-chip" href={`/tags/${tagSlug(tag)}/`}>{tag}</a>
      ))}
    </div>

    <div class="posts-layout">
      <div>
        <div class="posts-list">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
        <Pagination currentPage={currentPage} lastPage={lastPage} basePath="/posts" />
      </div>
      <PostsAside tags={tags} />
    </div>
  </div>
</BaseLayout>
