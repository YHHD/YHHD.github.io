---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getWiki } from '../../lib/content';
import { formatDate } from '../../lib/site';

type Item = { title: string; date: Date; href: string; type: '文章' | 'Wiki' };
const posts = await getPosts();
const wiki = await getWiki();
const items: Item[] = [
  ...posts.map((post) => ({ title: post.data.title, date: post.data.date, href: `/posts/${post.id}/`, type: '文章' as const })),
  ...wiki.map((entry) => ({ title: entry.data.title, date: entry.data.date, href: `/wiki/${entry.id}/`, type: 'Wiki' as const })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());

const groups = new Map<number, Item[]>();
for (const item of items) {
  const list = groups.get(item.date.getFullYear()) ?? [];
  list.push(item);
  groups.set(item.date.getFullYear(), list);
}
---

<BaseLayout title="归档" description="按时间浏览 YHHD Notes 的全部文章与 Wiki 词条。">
  <div class="container simple-page">
    <header class="simple-page__heading">
      <h1>归档</h1>
      <p>按时间回看，共 {items.length} 条内容。</p>
    </header>
    <div class="archive-simple">
      {[...groups.entries()].sort((a, b) => b[0] - a[0]).map(([year, yearItems]) => (
        <section class="archive-year">
          <h2>{year}</h2>
          <div class="archive-simple__items">
            {yearItems.map((item) => (
              <a class="archive-simple__row" href={item.href}>
                <time datetime={item.date.toISOString()}>{formatDate(item.date)}</time>
                <span>{item.title}</span>
                <small>{item.type}</small>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
