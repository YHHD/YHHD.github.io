---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getWiki } from '../../lib/content';
import { CATEGORY_STICKER, WIKI_CATEGORY_ORDER, categoryStyle } from '../../lib/site';

const entries = await getWiki();
const groups = WIKI_CATEGORY_ORDER
  .map((category) => ({ category, entries: entries.filter((entry) => entry.data.category === category) }))
  .filter((group) => group.entries.length > 0);

const categoryLabels: Record<string, string> = {
  'AI 与 Agent': 'AGENT',
  '项目与方案': 'PROJECTS',
  '技术手册': 'HANDBOOK',
  '研究资料': 'RESEARCH',
};
---

<BaseLayout title="知识库" description="按主题组织的个人知识库：AI Agent、技术手册、项目方案与研究资料。">
  <section class="wiki-landing">
    <div class="container">
      <div class="wiki-maintenance">
        <span class="wiki-maintenance__dot"></span>
        本知识库由 Markdown 内容构建，按主题整理并持续更新。
      </div>
      <h1>YHHD Wiki</h1>
      <p>记录 AI Agent、工具与工程实践。每个词条保留应用场景、边界和与其他系统的差异。</p>
    </div>
  </section>

  <div class="container">
    <div class="wiki-categories wiki-categories--landing">
      {groups.map((group) => (
        <section class="wiki-category" data-wiki-category>
          <div class="wiki-category__heading">
            <span class="wiki-category__dot" style={`--dot: ${CATEGORY_STICKER[group.category] ?? 'var(--blue)'}`}></span>
            <h2>{group.category} · {categoryLabels[group.category] ?? 'NOTES'}</h2>
            <span class="rule"></span>
            <span>{String(group.entries.length).padStart(2, '0')}</span>
          </div>
          <div class="wiki-entries">
            {group.entries.map((entry) => (
              <a class="wiki-entry" href={`/wiki/${entry.id}/`}>
                <span class="wiki-entry__dot" style={`--dot: ${categoryStyle(entry.data.category).color}`}></span>
                <span class="wiki-entry__body">
                  <strong>{entry.data.title}</strong>
                </span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
