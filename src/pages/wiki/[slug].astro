---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getWiki } from '../../lib/content';
import { formatDate, isoDate, readingTime, tagSlug, wordCount } from '../../lib/site';

export async function getStaticPaths() {
  const entries = await getWiki();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const allEntries = await getWiki();
const categoryEntries = allEntries.filter((item) => item.data.category === entry.data.category);
const index = categoryEntries.findIndex((item) => item.id === entry.id);
const previous = index > 0 ? categoryEntries[index - 1] : undefined;
const next = index < categoryEntries.length - 1 ? categoryEntries[index + 1] : undefined;
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const minutes = readingTime(entry.body ?? '');
const words = wordCount(entry.body ?? '');
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  publishedTime={entry.data.date}
  updatedTime={entry.data.updated}
>
  <div class="container article-page article-page--simple" data-reading-scope>
    <div class="article-single">
      <nav class="breadcrumb" aria-label="面包屑">
        <a href="/wiki/">知识库</a>
        <Icon name="chevron-right" />
        <span>{entry.data.category}</span>
      </nav>

      <header class="article-header">
        <h1>{entry.data.title}</h1>
        <div class="meta-row">
          <time datetime={isoDate(entry.data.date)}>{formatDate(entry.data.date, 'long')}</time>
          <span class="dot"></span>
          <span>{words.toLocaleString('zh-CN')} 字</span>
          <span class="dot"></span>
          <span>阅读约 {minutes} 分钟</span>
        </div>
        <div class="tag-row">
          {entry.data.tags.map((tag) => (
            <a class="tag" href={`/tags/${tagSlug(tag)}/`}>#{tag}</a>
          ))}
        </div>
      </header>

      {tocHeadings.length > 0 && (
        <details class="article-toc">
          <summary>目录 · {tocHeadings.length} 节</summary>
          <nav>
            {tocHeadings.map((heading) => (
              <a href={`#${heading.slug}`} class={heading.depth === 3 ? 'depth-3' : undefined}>{heading.text}</a>
            ))}
          </nav>
        </details>
      )}

      <article class="post-prose">
        <Content />
      </article>

      <footer class="article-footer article-footer--simple">
        <div class="tag-row">
          {entry.data.tags.map((tag) => (
            <a class="tag" href={`/tags/${tagSlug(tag)}/`}>#{tag}</a>
          ))}
        </div>
        <nav class="article-nav" aria-label="相邻词条">
          {previous ? (
            <a href={`/wiki/${previous.id}/`}>
              <span>← 上一词条</span>
              <strong>{previous.data.title}</strong>
            </a>
          ) : null}
          {next ? (
            <a href={`/wiki/${next.id}/`}>
              <span>下一词条 →</span>
              <strong>{next.data.title}</strong>
            </a>
          ) : null}
        </nav>
      </footer>
    </div>
  </div>
</BaseLayout>
