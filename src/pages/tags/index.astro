---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getWiki, tagCounts } from '../../lib/content';
import { tagSlug } from '../../lib/site';

const posts = await getPosts();
const wiki = await getWiki();
const tags = tagCounts([...posts, ...wiki]);
---

<BaseLayout title="标签" description="按标签浏览博客与知识库词条。">
  <div class="container simple-page">
    <header class="simple-page__heading">
      <h1>标签</h1>
      <p>共 {tags.length} 个标签，连接博客与知识库。</p>
    </header>
    <div class="simple-tag-list">
      {tags.map(([tag, count]) => (
        <a href={`/tags/${tagSlug(tag)}/`}><span>#{tag}</span><strong>{count}</strong></a>
      ))}
    </div>
  </div>
</BaseLayout>
