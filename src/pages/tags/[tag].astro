---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, getWiki, tagCounts } from '../../lib/content';
import { formatDate, tagSlug } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  const wiki = await getWiki();
  const tags = tagCounts([...posts, ...wiki]).map(([tag]) => tag);
  return tags.map((tag) => ({ params: { tag: tagSlug(tag) }, props: { tag } }));
}

const { tag } = Astro.props;
const posts = (await getPosts()).filter((post) => post.data.tags.includes(tag));
const wiki = (await getWiki()).filter((entry) => entry.data.tags.includes(tag));
const total = posts.length + wiki.length;
---

<BaseLayout title={`#${tag}`} description={`标记为 ${tag} 的博客和知识库词条。`} noindex>
  <div class="container simple-page">
    <header class="simple-page__heading">
      <h1>#{tag}</h1>
      <p>{posts.length} 篇博客 · {wiki.length} 条知识库</p>
    </header>

    {posts.length > 0 && <div class="ref-post-list">{posts.map((post) => <PostCard post={post} />)}</div>}

    {wiki.length > 0 && (
      <div class="simple-wiki-list">
        {wiki.map((entry) => (
          <a class="simple-wiki-row" href={`/wiki/${entry.id}/`}>
            <span>{entry.data.title}</span>
            <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
          </a>
        ))}
      </div>
    )}

    {total === 0 && <div class="empty-state">这个标签下暂时没有内容。</div>}
    <a class="ref-sidebar__all" href="/tags/">返回全部标签</a>
  </div>
</BaseLayout>
