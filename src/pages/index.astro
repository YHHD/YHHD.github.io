---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getPosts, getWiki } from '../lib/content';

const posts = await getPosts();
const wikiEntries = await getWiki();
const recentPosts = posts.slice(0, 10);
const recentWiki = wikiEntries.slice(0, 7);
const monthDay = (date: Date) =>
  new Intl.DateTimeFormat('zh-CN', { month: '2-digit', day: '2-digit' })
    .format(date)
    .replaceAll('/', '/');
---

<BaseLayout>
  <div class="container home-portal">
    <nav class="portal-grid" aria-label="站点入口">
      <a class="portal-card" href="/posts/" style="--portal-accent: var(--orange); --portal-soft: var(--orange-soft);">
        <span class="portal-card__icon"><Icon name="pen" /></span>
        <span class="portal-card__copy"><strong>博客</strong><small>随时写下的工程札记</small></span>
        <Icon name="chevron-right" class="portal-card__arrow" />
      </a>
      <a class="portal-card" href="/wiki/" style="--portal-accent: var(--sky); --portal-soft: var(--sky-soft);">
        <span class="portal-card__icon"><Icon name="network" /></span>
        <span class="portal-card__copy"><strong>知识库</strong><small>持续维护的互链词条</small></span>
        <Icon name="chevron-right" class="portal-card__arrow" />
      </a>
      <a class="portal-card" href="/about/" style="--portal-accent: var(--purple-deep); --portal-soft: var(--purple-soft);">
        <span class="portal-card__icon"><Icon name="user" /></span>
        <span class="portal-card__copy"><strong>关于</strong><small>关于这个站点</small></span>
        <Icon name="chevron-right" class="portal-card__arrow" />
      </a>
    </nav>

    <div class="home-feed-grid">
      <section class="home-feed" aria-labelledby="home-posts-title">
        <div class="home-feed__heading">
          <h1 id="home-posts-title">博客</h1>
          <a href="/posts/">全部 <Icon name="arrow-right" /></a>
        </div>
        <div class="home-post-list">
          {recentPosts.map((post) => (
            <a class="home-post-row" href={`/posts/${post.id}/`}>
              <time datetime={post.data.date.toISOString()}>{monthDay(post.data.date)}</time>
              <span>{post.data.title}</span>
            </a>
          ))}
        </div>
        <a class="home-more" href="/posts/">查看全部 {posts.length} 篇博客 <Icon name="arrow-right" /></a>
      </section>

      <section class="home-feed" aria-labelledby="home-wiki-title">
        <div class="home-feed__heading">
          <h2 id="home-wiki-title">知识库</h2>
          <a href="/wiki/">全部 <Icon name="arrow-right" /></a>
        </div>
        <div class="home-wiki-list">
          {recentWiki.map((entry) => (
            <a class="home-wiki-item" href={`/wiki/${entry.id}/`}>
              <strong>{entry.data.title}</strong>
              <p>{entry.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
